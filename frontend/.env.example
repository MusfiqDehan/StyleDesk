# Browser API calls always use this salon's /api/backend proxy.
INTERNAL_API_BASE_URL=http://localhost:4000
NEXT_TELEMETRY_DISABLED=1
# Production routing; metadata derives its origin from the request host.
APP_DOMAIN=example.com
TENANT_HOST_RULE=HostRegexp(`^[a-z0-9-]+\.example\.com$`)
TLS_CERT_RESOLVER=letsencrypt
# Extra image sources, if needed.
IMAGE_ALLOWED_ORIGINS=

# Same host in Next server and browser bundle. Production: styledesk.musfiqdehan.com
PLATFORM_HOST=localhost
NEXT_PUBLIC_PLATFORM_HOST=localhost
# Include both platform root and tenant wildcard in TENANT_HOST_RULE for production.
