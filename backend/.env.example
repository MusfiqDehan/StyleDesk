# Runtime settings; no schema synchronization or startup admin creation.
NODE_ENV=development
PORT=4000
TENANT_BASE_DOMAIN=localhost
JWT_SECRET=replace-with-a-long-random-secret
DATABASE_URL=postgresql://styledesk_runtime:replace-runtime-password@localhost:5433/styledesk_tenancy
RUNTIME_DATABASE_ROLE=styledesk_runtime
RUNTIME_DATABASE_PASSWORD=replace-runtime-password
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace-operator-password
POSTGRES_DB=styledesk_tenancy
# New volume; existing legacy databases are retained.
TENANCY_DB_VOLUME=styledesk_tenancy_pg16_dev
REDIS_HOST=localhost
REDIS_PORT=6380
# Exact trusted proxy socket IPs; empty means forwarded host headers are ignored.
TRUSTED_PROXY_IPS=
MAIL_SECURE=true
MAIL_HOST=
MAIL_PORT=465
MAIL_USER=
MAIL_PASS=
MAIL_FROM=
# Production: set TENANT_BASE_DOMAIN to your base domain, configure wildcard DNS/TLS.
APP_DOMAIN=example.com
TENANT_HOST_RULE=HostRegexp(`^[a-z0-9-]+\.example\.com$`)
TLS_CERT_RESOLVER=letsencrypt
ADMS_HOST_PORT=4400
# Operator-only: export MIGRATION_DATABASE_URL and TENANT_ADMIN_PASSWORD when
# running migrations/provisioning. Never pass them to the running API.
# Devices require per-registration secret injection or an explicit source IP.

# Platform control connection has explicit grants, never SUPERUSER/BYPASSRLS.
PLATFORM_DATABASE_URL=postgresql://styledesk_platform:replace-platform-password@localhost:5433/styledesk_tenancy
PLATFORM_DATABASE_ROLE=styledesk_platform
PLATFORM_DATABASE_PASSWORD=replace-platform-password
PLATFORM_JWT_SECRET=replace-with-a-different-long-random-secret
# Generate with: openssl rand -hex 32. Keep durable; rotating needs data re-encryption.
PAYMENT_ENCRYPTION_KEY=replace-with-64-hex-characters
PLATFORM_HOST=localhost
PLATFORM_PUBLIC_URL=http://localhost:3000
PUBLIC_URL_SCHEME=http
PUBLIC_URL_PORT=3000
STRIPE_API_VERSION=2024-06-20
# Production: PLATFORM_HOST=TENANT_BASE_DOMAIN=styledesk.musfiqdehan.com
# TENANT_HOST_RULE=Host(`styledesk.musfiqdehan.com`) || HostRegexp(`^[a-z0-9-]+\.styledesk\.musfiqdehan\.com$`)
# PLATFORM_PUBLIC_URL=https://styledesk.musfiqdehan.com; PUBLIC_URL_SCHEME=https; PUBLIC_URL_PORT=
# Enable only on dedicated domain worker; generated volume is shared read-only with Traefik.
DOMAIN_WORKER=false
STYLEDESK_TRAEFIK_DIR=
DOMAIN_CNAME_TARGET=styledesk.musfiqdehan.com
DOMAIN_PUBLIC_IP=
SSLCOMMERZ_FALLBACK_PHONE=01700000000
# Operator commands only: MIGRATION_DATABASE_URL, PLATFORM_ADMIN_EMAIL/PASSWORD.
# Gateway secrets are supplied through the authenticated UI, never frontend environment variables.
